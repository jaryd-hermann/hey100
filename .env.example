# Supabase and Postgres credentials are provisioned through the Vercel
# Marketplace and live on the `hey100-app` Vercel project, so the real values
# are never kept by hand:
#
#   vercel env pull .env.local --yes
#
# That writes the Supabase, Postgres and EXPO_PUBLIC_* values below. Only add a
# variable here by hand if it is not managed by Vercel.

# Supabase — auth, Postgres, storage, edge functions
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# PostHog — analytics and session replay
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=

# RevenueCat — Apple IAP public SDK key (appl_…). Secret keys stay off the client.
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
