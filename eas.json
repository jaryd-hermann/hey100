{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": { "simulator": true },
      "android": { "buildType": "apk" },
      "env": { "NPM_CONFIG_LEGACY_PEER_DEPS": "true" }
    },
    "device": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": { "simulator": false },
      "android": { "buildType": "apk" },
      "env": { "NPM_CONFIG_LEGACY_PEER_DEPS": "true" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "ios": { "simulator": false },
      "android": { "buildType": "apk" },
      "env": { "NPM_CONFIG_LEGACY_PEER_DEPS": "true" }
    },
    "production": {
      "environment": "production",
      "ios": { "simulator": false, "image": "latest", "buildConfiguration": "Release" },
      "android": { "buildType": "app-bundle" },
      "autoIncrement": true,
      "env": { "NPM_CONFIG_LEGACY_PEER_DEPS": "true" }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "6825970281" },
      "android": { "track": "internal", "releaseStatus": "completed" }
    }
  }
}
