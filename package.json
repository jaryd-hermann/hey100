{
  "name": "hey100",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "env:pull": "vercel env pull .env.local --yes",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/supabase.ts",
    "seed:demo": "node scripts/seed-demo.mjs",
    "verify": "npm run verify:loop && npm run verify:qa && npm run verify:realtime",
    "verify:loop": "python3 scripts/verify-loop.py",
    "verify:qa": "python3 scripts/verify-qa.py",
    "verify:realtime": "node --experimental-websocket scripts/verify-realtime.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.17.0",
    "base64-arraybuffer": "^1.0.2",
    "date-fns": "^3.0.0",
    "expo": "^54.0.23",
    "expo-apple-authentication": "~8.0.7",
    "expo-application": "~7.0.7",
    "expo-blur": "~15.0.7",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.13",
    "expo-device": "~8.0.9",
    "expo-file-system": "~19.0.17",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-localization": "~17.0.7",
    "expo-notifications": "~0.32.12",
    "expo-router": "~6.0.14",
    "expo-secure-store": "~15.0.7",
    "expo-sharing": "~14.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-store-review": "~9.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-updates": "~29.0.12",
    "expo-video": "~3.0.11",
    "expo-web-browser": "~15.0.8",
    "posthog-react-native": "^4.12.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "expo-build-properties": "~1.0.9",
    "typescript": "~5.9.2"
  }
}
